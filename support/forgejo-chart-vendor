#!/usr/bin/env bash
#
# forgejo-chart-vendor - vendor an upstream Helm chart into Harbor via a Forgejo pull-mirror.
#
#   upstream $UPSTREAM (git URL, Chart.yaml at the root)
#     -> $FORGEJO_URL/$MIRROR_OWNER/$MIRROR_REPO   native Forgejo pull-mirror (auto-refreshed)
#     -> $HARBOR/$HARBOR_PATH/<chart>              OCI chart in a public Harbor project
#
# Idempotent: creates the mirror if absent, retunes the interval if present, syncs, clones,
# packages, pushes. Re-run any time to publish the latest upstream chart.
#
# Usage: forgejo-chart-vendor [options]
#
set -euo pipefail

PROG="${0##*/}"

# ---- config (env-overridable) ----------------------------------------------
FORGEJO_URL="${FORGEJO_URL:-https://git.vn.linuxguru.net}"
FORGEJO_NAMESPACE="${FORGEJO_NAMESPACE:-devops-forgejo}"
FORGEJO_ADMIN_SECRET="${FORGEJO_ADMIN_SECRET:-forgejo-admin}"

UPSTREAM="${UPSTREAM:-https://code.forgejo.org/forgejo-helm/forgejo-runner}"
MIRROR_OWNER="${MIRROR_OWNER:-forgejo}"
MIRROR_REPO="${MIRROR_REPO:-forgejo-runner}"
MIRROR_INTERVAL="${MIRROR_INTERVAL:-72h0m0s}"   # forgejo pulls a fresh copy on this cadence

HARBOR="${HARBOR:-harbor.vn.linuxguru.net}"
HARBOR_NAMESPACE="${HARBOR_NAMESPACE:-devops-harbor}"
HARBOR_SECRET="${HARBOR_SECRET:-harbor-auth}"
HARBOR_PATH="${HARBOR_PATH:-library/charts}"    # charts sit beside, not among, the images

VENDOR_DIR="${VENDOR_DIR:-$PWD/.tmp/vendor}"

# Metadata stamped onto the mirror org + repo, as breadcrumbs for whoever lands there.
ORG_FULLNAME="${ORG_FULLNAME:-Forgejo}"
ORG_DESCRIPTION="${ORG_DESCRIPTION:-Read-only mirrors of upstream Forgejo projects; vendored into Harbor by support/forgejo-chart-vendor.}"
ORG_WEBSITE="${ORG_WEBSITE:-https://forgejo.org}"
ORG_LOCATION="${ORG_LOCATION:-}"
REPO_DESCRIPTION="${REPO_DESCRIPTION:-Mirror of ${UPSTREAM} (Forgejo Actions runner Helm chart); vendored to oci://${HARBOR}/${HARBOR_PATH}/${MIRROR_REPO} by support/forgejo-chart-vendor.}"
REPO_WEBSITE="${REPO_WEBSITE:-${UPSTREAM}}"

# ---- flags ------------------------------------------------------------------
DRY=0; DO_SYNC=1; REPLACE=0
die()  { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
info() { printf '==> %s\n' "$*"; }
log()  { printf '    %s\n' "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }

usage() {
  sed -n '2,9p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
  cat <<'EOF'
Options:
  -n, --dry-run          show what would happen, change nothing
      --no-sync          skip triggering a mirror-sync (use the mirror as-is)
      --replace          delete a non-mirror repo of the same name, then mirror it
      --upstream URL     upstream git URL            (default: forgejo-helm/forgejo-runner)
      --interval DUR     mirror refresh duration     (default: 72h0m0s)
      --owner NAME       Forgejo org for the mirror  (default: forgejo)
      --repo NAME        Forgejo repo name           (default: forgejo-runner)
  -h, --help             this help
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    -n|--dry-run) DRY=1 ;;
    --no-sync)    DO_SYNC=0 ;;
    --replace)    REPLACE=1 ;;
    --upstream)   UPSTREAM="${2:?}"; shift ;;
    --interval)   MIRROR_INTERVAL="${2:?}"; shift ;;
    --owner)      MIRROR_OWNER="${2:?}"; shift ;;
    --repo)       MIRROR_REPO="${2:?}"; shift ;;
    -h|--help)    usage; exit 0 ;;
    *)            die "unknown option: $1 (try --help)" ;;
  esac
  shift
done

for c in kubectl curl git helm jq; do have "$c" || die "missing required tool: $c"; done

# ---- credentials ------------------------------------------------------------
# Forgejo: the break-glass local admin (managing a mirror needs admin/org rights).
# Harbor: only for the push; pulls are anonymous (the project is public).
kget() { kubectl -n "$1" get secret "$2" -o jsonpath="{.data.$3}" | base64 -d; }

FJ_USER="${FORGEJO_USER:-$(kget "$FORGEJO_NAMESPACE" "$FORGEJO_ADMIN_SECRET" username)}"
FJ_PASS="${FORGEJO_PASS:-$(kget "$FORGEJO_NAMESPACE" "$FORGEJO_ADMIN_SECRET" password)}"
HARBOR_USER="${HARBOR_USER:-$(kget "$HARBOR_NAMESPACE" "$HARBOR_SECRET" username)}"
HARBOR_PASS="${HARBOR_PASS:-$(kget "$HARBOR_NAMESPACE" "$HARBOR_SECRET" password)}"
[ -n "$FJ_USER" ] && [ -n "$FJ_PASS" ] || die "empty Forgejo creds from $FORGEJO_NAMESPACE/$FORGEJO_ADMIN_SECRET"

API_CODE=000
API_BODY=''
api() {  # api METHOD PATH [JSON]  -> body in $API_BODY, HTTP status in $API_CODE (never echo!)
  local m="$1" p="$2" body="${3:-}" tmp
  # Dry run: skip writes, but let GETs through so the report reflects real state.
  if [ "$DRY" = 1 ] && [ "$m" != "GET" ]; then
    API_CODE=000; API_BODY='{}'; log "DRY: $m /api/v1$p"; return 0
  fi
  tmp="$(mktemp)"
  if [ -n "$body" ]; then
    API_CODE="$(curl -sS -u "$FJ_USER:$FJ_PASS" -H 'Content-Type: application/json' -X "$m" "$FORGEJO_URL/api/v1$p" -d "$body" -o "$tmp" -w '%{http_code}')" || API_CODE=000
  else
    API_CODE="$(curl -sS -u "$FJ_USER:$FJ_PASS" -X "$m" "$FORGEJO_URL/api/v1$p" -o "$tmp" -w '%{http_code}')" || API_CODE=000
  fi
  API_BODY="$(cat "$tmp")"; rm -f "$tmp"
}

# ---- 1. ensure the mirror org ----------------------------------------------
info "org $MIRROR_OWNER"
api GET "/orgs/$MIRROR_OWNER" >/dev/null
if [ "$API_CODE" != "200" ]; then
  log "creating org"
  api POST /orgs "$(jq -nc \
    --arg u "$MIRROR_OWNER" --arg f "$ORG_FULLNAME" --arg d "$ORG_DESCRIPTION" \
    --arg w "$ORG_WEBSITE" --arg l "$ORG_LOCATION" \
    '{username:$u,full_name:$f,description:$d,website:$w,location:$l,visibility:"public"}')" >/dev/null
  [ "$API_CODE" = "201" ] || [ "$DRY" = 1 ] || die "org create failed ($API_CODE)"
fi

# ---- 2. ensure the pull-mirror ---------------------------------------------
info "mirror $MIRROR_OWNER/$MIRROR_REPO <- $UPSTREAM (every $MIRROR_INTERVAL)"
api GET "/repos/$MIRROR_OWNER/$MIRROR_REPO"
repo_json="$API_BODY"
if [ "$API_CODE" = "200" ]; then
  if [ "$(printf '%s' "$repo_json" | jq -r '.mirror')" != "true" ]; then
    [ "$REPLACE" = 1 ] || die "$MIRROR_OWNER/$MIRROR_REPO exists and is NOT a mirror; re-run with --replace"
    log "deleting non-mirror repo, re-mirroring"
    api DELETE "/repos/$MIRROR_OWNER/$MIRROR_REPO" >/dev/null
    API_CODE=404
  else
    log "retuning interval -> $MIRROR_INTERVAL"
    api PATCH "/repos/$MIRROR_OWNER/$MIRROR_REPO" \
      "$(jq -nc --arg i "$MIRROR_INTERVAL" '{mirror_interval:$i}')" >/dev/null
  fi
fi

if [ "$API_CODE" = "404" ]; then
  log "migrating (mirror)"
  # NB: omit `service` -- setting it makes Forgejo call the forge API for metadata and hang.
  api POST /repos/migrate "$(jq -nc \
    --arg url "$UPSTREAM" --arg o "$MIRROR_OWNER" --arg r "$MIRROR_REPO" --arg i "$MIRROR_INTERVAL" \
    '{clone_addr:$url,repo_owner:$o,repo_name:$r,mirror:true,mirror_interval:$i,private:false,
      lfs:false,issues:false,pull_requests:false,releases:false,labels:false,milestones:false,wiki:false}')" >/dev/null
  [ "$API_CODE" = "201" ] || [ "$DRY" = 1 ] || die "migrate failed ($API_CODE)"
fi

# ---- 2b. metadata: description/website on the org + mirror (breadcrumbs) ----
# The org PATCH is undocumented but is served (the swagger omits it). Never fatal -- vendoring a
# chart should still succeed even if a future Forgejo drops these fields.
info "metadata"
api PATCH "/orgs/$MIRROR_OWNER" "$(jq -nc \
  --arg f "$ORG_FULLNAME" --arg d "$ORG_DESCRIPTION" --arg w "$ORG_WEBSITE" --arg l "$ORG_LOCATION" \
  '{full_name:$f,description:$d,website:$w,location:$l}')"
[ "$API_CODE" = "200" ] || [ "$DRY" = 1 ] || log "warn: org metadata -> $API_CODE"
api PATCH "/repos/$MIRROR_OWNER/$MIRROR_REPO" "$(jq -nc \
  --arg d "$REPO_DESCRIPTION" --arg w "$REPO_WEBSITE" \
  '{description:$d,website:$w}')"
[ "$API_CODE" = "200" ] || [ "$DRY" = 1 ] || log "warn: repo metadata -> $API_CODE"

# ---- 3. sync now, so the clone is fresh ------------------------------------
if [ "$DO_SYNC" = 1 ]; then
  info "triggering mirror-sync"
  api POST "/repos/$MIRROR_OWNER/$MIRROR_REPO/mirror-sync" >/dev/null
  [ "$DRY" = 1 ] || sleep 5
fi

# ---- 4. clone the mirror ----------------------------------------------------
info "cloning -> $VENDOR_DIR"
if [ "$DRY" != 1 ]; then
  rm -rf "$VENDOR_DIR"
  # The instance sets REQUIRE_SIGNIN_VIEW=true, so even a public repo needs auth to clone.
  # Pass it as a one-off header so the credential is never written into the clone's .git/config.
  auth="$(printf '%s:%s' "$FJ_USER" "$FJ_PASS" | base64)"
  git -c http.extraHeader="Authorization: Basic $auth" \
    clone --quiet --depth 1 "$FORGEJO_URL/$MIRROR_OWNER/$MIRROR_REPO.git" "$VENDOR_DIR"
fi
if [ "$DRY" = 1 ]; then
  info "dry run complete"
  exit 0
fi
[ -f "$VENDOR_DIR/Chart.yaml" ] || die "no Chart.yaml in the mirror root"

chart="$(helm show chart "$VENDOR_DIR" | awk '/^name:/{print $2}')"
version="$(helm show chart "$VENDOR_DIR" | awk '/^version:/{print $2}' | tr -d '"')"
info "chart $chart $version"

# ---- 5. package + push to Harbor -------------------------------------------
info "packaging"
helm package "$VENDOR_DIR" -d "$VENDOR_DIR" >/dev/null
tgz="$VENDOR_DIR/$chart-$version.tgz"
[ -f "$tgz" ] || die "expected package not found: $tgz"

info "login $HARBOR"
helm registry login "$HARBOR" -u "$HARBOR_USER" -p "$HARBOR_PASS" >/dev/null 2>&1 \
  || die "helm registry login failed"

info "pushing"
# Idempotent: a chart version already in Harbor is a no-op, not an error.
if helm push "$tgz" "oci://$HARBOR/$HARBOR_PATH"; then
  :
elif helm show chart "oci://$HARBOR/$HARBOR_PATH/$chart:$version" >/dev/null 2>&1; then
  info "already in Harbor: $chart:$version (nothing to push)"
else
  die "push failed and $chart:$version is not in Harbor"
fi

cat <<EOF

==> published  oci://$HARBOR/$HARBOR_PATH/$chart:$version

  Terraform (modules/forgejo-runner):
    chart_repository = "oci://$HARBOR/$HARBOR_PATH"
    chart            = "$chart"
    chart_version    = "$version"
EOF
