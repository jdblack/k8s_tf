{
  "annotations": { "list": [] },
  "description": "Immich telemetry from the server's OpenTelemetry Prometheus exporter. Job and queue panels use regex selectors because Immich encodes the job/queue in the metric name (immich.jobs.<job>.success -> immich_jobs_<job>_success_total) and only creates them once such a job has run. Latency panels use the repository histograms; Immich exports no HTTP-level metrics.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Users",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [ { "refId": "A", "expr": "max(immich_users_total) or vector(0)", "datasource": { "type": "prometheus", "uid": "$datasource" }, "editorMode": "code", "legendFormat": "", "range": true } ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active jobs",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [ { "refId": "A", "expr": "sum({__name__=~\"immich_queues_.+_active\"}) or vector(0)", "datasource": { "type": "prometheus", "uid": "$datasource" }, "editorMode": "code", "legendFormat": "", "range": true } ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Failed jobs (24h)",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [ { "refId": "A", "expr": "sum(increase({__name__=~\"immich_jobs_.+_fail.*\"}[24h])) or vector(0)", "datasource": { "type": "prometheus", "uid": "$datasource" }, "editorMode": "code", "legendFormat": "", "range": true } ],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Scrapes up",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [ { "refId": "A", "expr": "sum(up{service=\"immich-server\"})", "datasource": { "type": "prometheus", "uid": "$datasource" }, "editorMode": "code", "legendFormat": "", "range": true } ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Active jobs by queue",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [ { "refId": "A", "expr": "{__name__=~\"immich_queues_.+_active\"}", "datasource": { "type": "prometheus", "uid": "$datasource" }, "editorMode": "code", "legendFormat": "{{__name__}}", "range": true } ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": [ "lastNotNull" ] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Job throughput by type",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [ { "refId": "A", "expr": "rate({__name__=~\"immich_jobs_.+_succe.*\"}[5m])", "datasource": { "type": "prometheus", "uid": "$datasource" }, "editorMode": "code", "legendFormat": "{{__name__}}", "range": true } ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 1, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": [ "lastNotNull" ] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Job failures by type",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [ { "refId": "A", "expr": "rate({__name__=~\"immich_jobs_.+_fail.*\"}[5m])", "datasource": { "type": "prometheus", "uid": "$datasource" }, "editorMode": "code", "legendFormat": "{{__name__}}", "range": true } ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 1, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": [ "lastNotNull" ] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Queue starts",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [ { "refId": "A", "expr": "rate({__name__=~\"immich_queues_.+_started.*\"}[5m])", "datasource": { "type": "prometheus", "uid": "$datasource" }, "editorMode": "code", "legendFormat": "{{__name__}}", "range": true } ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 1, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": [ "lastNotNull" ] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Repository call duration p95 (ms)",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate({__name__=~\"immich_.+_duration_bucket\"}[5m])))", "datasource": { "type": "prometheus", "uid": "$datasource" }, "editorMode": "code", "legendFormat": "all repository calls", "range": true } ],
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 1, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [ "lastNotNull" ] }, "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Postgres (database repo) p95 (ms)",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate({__name__=~\"immich_database_repository_.+_duration_bucket\"}[5m])))", "datasource": { "type": "prometheus", "uid": "$datasource" }, "editorMode": "code", "legendFormat": "db calls", "range": true } ],
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 1, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [ "lastNotNull" ] }, "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Server process memory",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [ { "refId": "A", "expr": "process_memory_usage", "datasource": { "type": "prometheus", "uid": "$datasource" }, "editorMode": "code", "legendFormat": "resident", "range": true } ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 1, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [ "lastNotNull" ] }, "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Server CPU",
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [ { "refId": "A", "expr": "sum(process_cpu_utilization)", "datasource": { "type": "prometheus", "uid": "$datasource" }, "editorMode": "code", "legendFormat": "cpu", "range": true } ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 1, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [ "lastNotNull" ] }, "tooltip": { "mode": "single", "sort": "none" } }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 41,
  "tags": [ "immich", "media" ],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "Prometheus", "value": "prometheus" },
        "hide": 0,
        "includeAll": false,
        "label": "Data source",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Immich",
  "uid": "immich",
  "version": 1,
  "weekStart": ""
}
