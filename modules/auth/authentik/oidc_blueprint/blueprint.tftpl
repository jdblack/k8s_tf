version: 1
metadata:
  name: ${name}
entries:
  # Order is load-bearing: a !KeyOf target must already exist when its referrer is applied. !KeyOf fails
  # closed (it raises); !Find returns None on a miss, so it is used only for authentik's own built-in
  # objects, which this blueprint cannot reference by key.
  - id: signing
    model: authentik_crypto.certificatekeypair
    identifiers:
      name: ${name}-signing
    attrs:
      name: ${name}-signing
      # Write-only in the model: the export omits them, so the PEMs have to be supplied from here.
      certificate_data: ${certificate_data}
      key_data: ${key_data}

  # The name and nothing else. Emitting users/parents would re-write the membership, and the umbrella
  # admin/user nesting that depends on it is owned by the stack that manages users.
  - id: group_admin
    model: authentik_core.group
    identifiers:
      name: ${name}-admin
    attrs:
      name: ${name}-admin

  - id: group_user
    model: authentik_core.group
    identifiers:
      name: ${name}-user
    attrs:
      name: ${name}-user

  - id: scope_groups
    model: authentik_providers_oauth2.scopemapping
    identifiers:
      name: "OpenID 'groups' (${name})"
    attrs:
      name: "OpenID 'groups' (${name})"
      scope_name: groups
      description: Groups claim for ${name}
      expression: ${expression_groups}

  - id: scope_profile
    model: authentik_providers_oauth2.scopemapping
    identifiers:
      name: "OpenID 'profile' (${name})"
    attrs:
      name: "OpenID 'profile' (${name})"
      scope_name: profile
      description: Profile claim for ${name}, with nested groups
      expression: ${expression_profile}

  - id: provider
    model: authentik_providers_oauth2.oauth2provider
    identifiers:
      name: ${name}
    attrs:
      name: ${name}
      client_id: ${name}
      client_secret: ${client_secret}
      client_type: confidential
      # Both resolve to default-provider-authorization-implicit-consent. The flow actually named
      # default-provider-invalidation-flow is a different object and is not what this provider uses.
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      signing_key: !KeyOf signing
      property_mappings:
        - !KeyOf scope_groups
        - !KeyOf scope_profile
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-email]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-offline_access]]
      grant_types:
        - authorization_code
        - hybrid
        - implicit
        - client_credentials
        - password
        - urn:ietf:params:oauth:grant-type:device_code
        - refresh_token
      access_code_validity: minutes=1
      access_token_validity: days=7
      refresh_token_validity: days=30
      refresh_token_threshold: seconds=0
      sub_mode: hashed_user_id
      issuer_mode: per_provider
      include_claims_in_id_token: true
      logout_method: backchannel
      # Required by the serializer: an absent or empty list is rejected outright.
      redirect_uris:${redirect_uris_yaml}

  - id: application
    model: authentik_core.application
    identifiers:
      slug: ${name}
    attrs:
      name: ${name}
      slug: ${name}
      provider: !KeyOf provider
      meta_icon: https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/forgejo.svg
      meta_launch_url: https://${fqdn}
      open_in_new_tab: true
      policy_engine_mode: any

  # Both own groups, not just -user: an admin has to be able to log in, and binding -user alone would force
  # every admin into a second group purely to authenticate.
  - id: binding_admin
    model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf application
      group: !KeyOf group_admin
    attrs:
      target: !KeyOf application
      group: !KeyOf group_admin
      order: 0
      enabled: true

  - id: binding_user
    model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf application
      group: !KeyOf group_user
    attrs:
      target: !KeyOf application
      group: !KeyOf group_user
      order: 0
      enabled: true
